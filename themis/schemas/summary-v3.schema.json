{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HemVadgama/Themis/raw/main/themis/schemas/summary-v3.schema.json",
  "title": "Themis campaign summary v3",
  "type": "object",
  "required": ["run_id", "experiment", "benchmark", "scenario", "protocol", "seed", "outcome", "metrics"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "experiment": {"type": "string", "minLength": 1},
    "benchmark": {"const": "spacecraft-campaign-v1"},
    "scenario": {"type": "string", "minLength": 1},
    "protocol": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0},
    "outcome": {"enum": ["resolved", "unresolved", "no-conjunctions"]},
    "metrics": {"type": "object", "required": ["risks_created", "risks_resolved", "risks_unresolved", "messages_sent", "maneuver_count", "cycles_completed"], "additionalProperties": true}
  },
  "additionalProperties": true
}
